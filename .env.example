# Só na primeira subida (cria o usuário). Depois do primeiro login, remova INIT_PASSWORD.
INIT_EMAIL=voce@seudominio.com.br
INIT_PASSWORD=

# Origem pública exata. Vazio = compara a Origin com o Host da requisição.
ALLOWED_ORIGIN=https://financas.seudominio.com.br

# Padrões (só mude se precisar)
# PORT=3000
# DATA_DIR=/data
# COOKIE_SECURE=true          # false só em desenvolvimento local sem HTTPS
# SESSION_DAYS=30
# TRUST_PROXY=true            # lê X-Real-IP / X-Forwarded-For do Traefik
# MAX_STATE_MB=25
# HISTORY_KEEP=60
# HISTORY_EVERY_MIN=30
# BACKUP_KEEP_DAYS=14
# LOGIN_MAX_FAILS_IP=8
# LOGIN_MAX_FAILS_GLOBAL=40
